# Convex Deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Site URL (for SEO, OpenGraph metadata, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------------------
# Backend Environment Variables (Configured in Convex Dashboard or `npx convex env set`)
# ------------------------------------------------------------
# Razorpay Key ID (Client & Server)
# RAZORPAY_KEY_ID=rzp_test_...

# Razorpay Key Secret (Server Only)
# RAZORPAY_KEY_SECRET=...

# Razorpay Webhook Secret (Server Only)
# RAZORPAY_WEBHOOK_SECRET=...

# Admin Email Addresses (Comma-separated)
# ADMIN_EMAILS=founder@yourdomain.com
